  shorttitle = {A Is for {{Absorption}}},
  author = {Chanin, David and {Wilken-Smith}, James and Dulka, Tom{\'a}{\v s} and Bhatnagar, Hardik and Golechha, Satvik and Bloom, Joseph},
  year = 2025,
