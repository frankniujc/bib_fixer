@misc{alqubojNumberRepresentationsLLMs2025,
  title = {Number {{Representations}} in {{LLMs}}: {{A Computational Parallel}} to {{Human Perception}}},
  shorttitle = {Number {{Representations}} in {{LLMs}}},
  author = {AlquBoj, H. V. and AlQuabeh, Hilal and Bojkovic, Velibor and Hiraoka, Tatsuya and {El-Shangiti}, Ahmed Oumar and Nwadike, Munachiso and Inui, Kentaro},
  year = 2025,
